# Chat provider: ollama (default) or groq
CHAT_PROVIDER=groq
OLLAMA_CHAT_MODEL=gemma3:4b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Required only when CHAT_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Ollama chat and embeddings
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# Chroma: leave CHROMA_HOST empty for embedded local Chroma.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=crop_knowledge_base

# Knowledge registry
CROP_REGISTRY_PATH=./data/crops.json

# App
APP_ENV=dev
LOG_LEVEL=INFO
SUPPORTED_LANGUAGES=bn,en

# Pipeline
RETRIEVAL_TOP_K=8
DENSE_CANDIDATE_K=20
BM25_CANDIDATE_K=20
BM25_CACHE_TTL_SECONDS=300
RRF_K=60
RERANK_TOP_K=4
LLM_TEMPERATURE=0.1
HISTORY_MAX_TURNS=6
CONTEXT_MAX_CHARS_PER_CHUNK=3000

# bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_USE_FP16=false
RERANKER_QUERY_MAX_LENGTH=256
RERANKER_PASSAGE_MAX_LENGTH=512
RERANKER_FAIL_OPEN=true
