FROM michaelf34/infinity:0.0.77-cpu

ENV HF_HOME=/app/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/app/.cache/huggingface/hub \
    INFINITY_ANONYMOUS_USAGE_STATS=0

# Pre-cache both retrieval models at image-build time so a new Azure
# Container Apps replica does not have to download ~4.5 GB before starting.
RUN python - <<'PY'
from huggingface_hub import snapshot_download

for model_id in (
    "BAAI/bge-m3",
    "BAAI/bge-reranker-v2-m3",
):
    snapshot_download(repo_id=model_id)
PY

# Production replicas use only the model files baked into this image.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

ENTRYPOINT ["infinity_emb"]
CMD ["v2", \
     "--model-id", "BAAI/bge-m3", \
     "--model-id", "BAAI/bge-reranker-v2-m3", \
     "--port", "7997", \
     "--engine", "torch"]
