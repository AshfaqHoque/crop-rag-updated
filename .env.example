# Chat provider: ollama, groq, or vllm
CHAT_PROVIDER=vllm
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
VLLM_CHAT_MODEL=gemma4:12b
VLLM_BASE_URL=http://10.30.0.2:8091/v1
VLLM_API_KEY=not-needed
VLLM_TOP_P=0.9
VLLM_TOP_K=30
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# Ollama chat and embeddings
OLLAMA_BASE_URL=http://10.30.0.2:11434
EMBED_MODEL=bge-m3:latest

# Chroma: leave CHROMA_HOST empty for embedded local Chroma.
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=crop_knowledge_base
CHROMA_COMPANY_COLLECTION=company_knowledge_base
CHROMA_SOIL_TEST_COLLECTION=soil_test_knowledge_base

# Knowledge registry
CROP_REGISTRY_PATH=./data/crops.json
GRAPHQL_ENDPOINT=https://aunkur-backend-311104304042.us-central1.run.app/graphql
GRAPHQL_TIMEOUT_SECONDS=30

# App
APP_ENV=dev
LOG_LEVEL=INFO

# Pipeline
RETRIEVAL_TOP_K=20
COMPANY_RETRIEVAL_TOP_K=3
SOIL_TEST_RETRIEVAL_TOP_K=3
RERANK_TOP_K=7
LLM_TEMPERATURE=0
CONTEXT_MAX_CHARS_PER_CHUNK=4000
COMPRESSION_TEMPERATURE=0.1
COMPRESSION_MAX_TOKENS=1000
RERANK_GAP_MULTIPLIER=60
RERANK_MIN_SCORE_DELTA=0.65
STREAM_CHUNK_DELAY_SECONDS=0.05

# Reranker service
RERANKER_URL=http://10.30.0.2:8090/rerank
RERANKER_TIMEOUT_SECONDS=30

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT="crop-rag-chatbot"

# Checkpointer: memory or redis
CHECKPOINT_BACKEND=memory
REDIS_URL=redis://10.30.0.2:6379/0

# Streamlit frontend
UI_API_URL=http://10.30.0.2:8000/api/v1/chat/stream
UI_REQUEST_TIMEOUT_SECONDS=120